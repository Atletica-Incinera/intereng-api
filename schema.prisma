// Prisma schema - Sistema de Gestão de Competições Esportivas Multi-Evento
// PostgreSQL 15+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EditionStatus {
  PLANNING
  ONGOING
  FINISHED
  ARCHIVED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  GROUP_KNOCKOUT
  LEAGUE_KNOCKOUT
  LEAGUE_ONLY
  LEAGUE_LIMITED_KNOCKOUT
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  ONGOING
  FINISHED
  CANCELLED
}

enum PhaseType {
  GROUP
  LEAGUE
  KNOCKOUT
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  WALKOVER
  CANCELLED
  POSTPONED
}

enum RosterStatus {
  ACTIVE
  INJURED
  SUSPENDED
  WITHDRAWN
}

enum EditionStaffRoleType {
  EDITION_ADMIN
  DISCIPLINE_MANAGER
}

enum EventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  POINT
  SET_WON
  FOUL
  TIMEOUT_CALLED
  SUBSTITUTION
  DISQUALIFICATION
  CHECKMATE
  WALKOVER_DECLARED
  OTHER
}

enum MatchEventSide {
  HOME
  AWAY
  NEUTRAL
}

enum OverallPosition {
  CHAMPION
  RUNNER_UP
  THIRD
  PARTICIPATION
}

enum OverallAwardOrigin {
  MANUAL
  AUTOMATIC
}

model Competition {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editions CompetitionEdition[]

  @@index([isActive])
  @@map("competitions")
}

model CompetitionEdition {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)

  year      Int
  name      String
  startDate DateTime      @db.Timestamptz(3)
  endDate   DateTime      @db.Timestamptz(3)
  status    EditionStatus @default(PLANNING)
  isActive  Boolean       @default(false)
  revision  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disciplines     EditionDiscipline[]
  teams           EditionTeam[]
  athletes        EditionAthlete[]
  staffRoles      EditionStaffRole[]
  refreshSessions RefreshSession[]
  overallMetrics  OverallMetric[]
  overallAwards   OverallAward[]
  overallClosures OverallClosure[]
  actionReceipts  EditionActionReceipt[]
  auditLogs       AuditLog[]

  @@unique([competitionId, year])
  @@index([competitionId, status])
  @@index([status, startDate])
  @@index([isActive])
  @@map("competition_editions")
}

model Discipline {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  isIndividual Boolean @default(false)
  description  String?

  createdAt DateTime @default(now())

  editionLinks EditionDiscipline[]

  @@map("disciplines")
}

model Team {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  initials    String?
  responsible String?
  logoKey     String?
  archived    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editionLinks EditionTeam[]
  rosters      EditionRoster[]
  entries      TournamentEntry[]

  @@index([archived, name])
  @@map("teams")
}

model Athlete {
  id        String    @id @default(cuid())
  name      String
  document  String?   @unique
  birthDate DateTime? @db.Date
  email     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editionLinks EditionAthlete[]
  rosters      EditionRoster[]
  entries      TournamentEntry[]
  matchEvents  MatchEvent[]

  @@index([name])
  @@map("athletes")
}

model Staff {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  isSuperAdmin Boolean @default(false)
  /// Marca as contas que ainda usam a senha inicial — a de convite ou a do
  /// bootstrap. Enquanto verdadeira, a sessão só alcança a troca de senha.
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())

  editionRoles      EditionStaffRole[] @relation("EditionStaffRoleAssignee")
  revokedStaffRoles EditionStaffRole[] @relation("EditionStaffRoleRevoker")
  refreshSessions   RefreshSession[]
  matchesStarted    Match[]            @relation("MatchStartedBy")
  matchesOperated   Match[]            @relation("MatchOperator")
  undoneMatchEvents MatchEvent[]       @relation("MatchEventUndoneBy")
  matchCorrections  MatchCorrection[]
  revokedAwards     OverallAward[]     @relation("OverallAwardRevokedBy")
  closuresCreated   OverallClosure[]   @relation("OverallClosureActor")
  closuresReopened  OverallClosure[]   @relation("OverallClosureReopenedBy")
  auditLogs         AuditLog[]

  @@map("staff")
}

model EditionTeam {
  id        String             @id @default(cuid())
  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  archived  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athletes EditionAthlete[]
  awards   OverallAward[]

  @@unique([editionId, teamId])
  @@index([editionId, archived])
  @@index([teamId])
  @@map("edition_teams")
}

model EditionAthlete {
  id          String             @id @default(cuid())
  editionId   String
  edition     CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     Athlete            @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  teamId      String?
  editionTeam EditionTeam?       @relation(fields: [editionId, teamId], references: [editionId, teamId], onDelete: Restrict)
  removed     Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([editionId, athleteId])
  @@index([editionId, removed])
  @@index([athleteId])
  @@index([editionId, teamId])
  @@map("edition_athletes")
}

model EditionDiscipline {
  id           String             @id @default(cuid())
  editionId    String
  edition      CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  disciplineId String
  discipline   Discipline         @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  config       Json?

  createdAt DateTime @default(now())

  rosters       EditionRoster[]
  staffRoles    EditionStaffRole[]
  tournaments   Tournament[]
  overallAwards OverallAward[]

  @@unique([editionId, disciplineId])
  @@unique([editionId, id])
  @@map("edition_disciplines")
}

model EditionRoster {
  id                  String            @id @default(cuid())
  editionDisciplineId String
  editionDiscipline   EditionDiscipline @relation(fields: [editionDisciplineId], references: [id], onDelete: Restrict)
  athleteId           String
  athlete             Athlete           @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  teamId              String?
  team                Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)

  jerseyNumber Int?
  status       RosterStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([editionDisciplineId, athleteId])
  @@index([teamId])
  @@index([athleteId])
  @@map("edition_rosters")
}

model EditionStaffRole {
  id        String             @id @default(cuid())
  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff              @relation("EditionStaffRoleAssignee", fields: [staffId], references: [id], onDelete: Cascade)

  editionDisciplineId String?
  editionDiscipline   EditionDiscipline?   @relation(fields: [editionId, editionDisciplineId], references: [editionId, id], onDelete: Restrict)
  role                EditionStaffRoleType

  revokedAt   DateTime? @db.Timestamptz(3)
  revokedById String?
  revokedBy   Staff?    @relation("EditionStaffRoleRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([editionId, revokedAt])
  @@index([editionId, staffId, editionDisciplineId, role, revokedAt])
  @@index([revokedById])
  @@map("edition_staff_roles")
}

model Tournament {
  id                  String            @id @default(cuid())
  editionDisciplineId String
  editionDiscipline   EditionDiscipline @relation(fields: [editionDisciplineId], references: [id], onDelete: Restrict)

  name   String
  format TournamentFormat
  status TournamentStatus @default(DRAFT)
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases  Phase[]
  entries TournamentEntry[]

  @@unique([editionDisciplineId, name])
  @@index([editionDisciplineId, status])
  @@map("tournaments")
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  athleteId    String?
  athlete      Athlete?   @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  seed         Int?

  createdAt DateTime @default(now())

  groupEntries         GroupEntry[]
  standings            PhaseStanding[]
  matchesAsEntryA      Match[]         @relation("MatchEntryA")
  matchesAsEntryB      Match[]         @relation("MatchEntryB")
  matchesWon           Match[]         @relation("MatchWinner")
  matchesWonByWalkover Match[]         @relation("MatchWalkoverWinner")
  matchEvents          MatchEvent[]

  @@unique([tournamentId, teamId])
  @@unique([tournamentId, athleteId])
  @@index([tournamentId])
  @@index([teamId])
  @@index([athleteId])
  @@map("tournament_entries")
}

model Phase {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  clientId     String
  order        Int
  name         String
  type         PhaseType
  config       Json?

  createdAt DateTime @default(now())

  groups    Group[]
  matches   Match[]
  standings PhaseStanding[]

  @@unique([tournamentId, order])
  @@unique([tournamentId, clientId])
  @@index([tournamentId])
  @@map("phases")
}

model Group {
  id      String @id @default(cuid())
  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  name    String

  createdAt DateTime @default(now())

  entries GroupEntry[]
  matches Match[]

  @@unique([phaseId, name])
  @@index([phaseId])
  @@map("groups")
}

model GroupEntry {
  id      String          @id @default(cuid())
  groupId String
  group   Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryId String
  entry   TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([groupId, entryId])
  @@map("group_entries")
}

model Match {
  id      String  @id @default(cuid())
  phaseId String
  phase   Phase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  round       Int?
  bracketSlot Int?

  entryAId String?
  entryA   TournamentEntry? @relation("MatchEntryA", fields: [entryAId], references: [id], onDelete: SetNull)
  entryBId String?
  entryB   TournamentEntry? @relation("MatchEntryB", fields: [entryBId], references: [id], onDelete: SetNull)

  winnerEntryId String?
  winnerEntry   TournamentEntry? @relation("MatchWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  scoreA Float @default(0)
  scoreB Float @default(0)

  currentPeriod Int       @default(1)
  clockSeconds  Int       @default(0)
  runningSince  DateTime? @db.Timestamptz(3)
  paused        Boolean   @default(true)
  periodScoreA  Int       @default(0)
  periodScoreB  Int       @default(0)

  startedAt   DateTime? @db.Timestamptz(3)
  startedById String?
  startedBy   Staff?    @relation("MatchStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  startNote   String?

  operatorId        String?
  operator          Staff?    @relation("MatchOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  operatorDeviceId  String?
  operatorName      String?
  operatorHeartbeat DateTime? @db.Timestamptz(3)

  tiebreak              Json?
  walkoverWinnerEntryId String?
  walkoverWinnerEntry   TournamentEntry? @relation("MatchWalkoverWinner", fields: [walkoverWinnerEntryId], references: [id], onDelete: SetNull)
  reason                String?

  lastEventSequence Int @default(0)

  status      MatchStatus @default(SCHEDULED)
  scheduledAt DateTime?   @db.Timestamptz(3)
  venue       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        MatchEvent[]
  periodResults MatchPeriodResult[]
  corrections   MatchCorrection[]

  @@index([status, scheduledAt])
  @@index([phaseId, round])
  @@index([groupId])
  @@index([entryAId])
  @@index([entryBId])
  @@index([winnerEntryId])
  @@index([operatorId, operatorDeviceId, operatorHeartbeat])
  @@index([walkoverWinnerEntryId])
  @@map("matches")
}

model MatchEvent {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  entryId String?
  entry   TournamentEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  athleteId String?
  athlete   Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  type     EventType
  metadata Json?

  detail               String?
  side                 MatchEventSide @default(NEUTRAL)
  elapsedSeconds       Int            @default(0)
  period               Int?
  periodElapsedSeconds Int?
  scoreA               Float?
  scoreB               Float?
  points               Int?
  previousScore        Json?

  undoneAt   DateTime? @db.Timestamptz(3)
  undoneById String?
  undoneBy   Staff?    @relation("MatchEventUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)

  sequence   Int
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now())

  @@unique([matchId, sequence])
  @@index([athleteId])
  @@index([entryId])
  @@index([matchId, undoneAt])
  @@index([undoneById])
  @@map("match_events")
}

model MatchPeriodResult {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  period  Int
  scoreA  Int
  scoreB  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, period])
  @@map("match_period_results")
}

model MatchCorrection {
  id          String  @id @default(cuid())
  matchId     String
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       Staff?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String
  reason      String
  beforeState Json
  afterState  Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([matchId, createdAt])
  @@index([actorId])
  @@map("match_corrections")
}

model PhaseStanding {
  id      String          @id @default(cuid())
  phaseId String
  phase   Phase           @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  entryId String
  entry   TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  played       Int   @default(0)
  won          Int   @default(0)
  drawn        Int   @default(0)
  lost         Int   @default(0)
  scoreFor     Float @default(0)
  scoreAgainst Float @default(0)
  points       Float @default(0)
  rank         Int?

  updatedAt DateTime @updatedAt

  @@unique([phaseId, entryId])
  @@index([phaseId, points(sort: Desc), scoreFor(sort: Desc)])
  @@map("phase_standings")
}

model OverallMetric {
  id            String             @id @default(cuid())
  editionId     String
  edition       CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  clientId      String
  name          String
  defaultPoints Int
  position      OverallPosition?
  removedAt     DateTime?          @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  awards OverallAward[]

  @@unique([editionId, clientId])
  @@unique([editionId, name])
  @@index([editionId, removedAt])
  @@map("overall_metrics")
}

model OverallAward {
  id                  String             @id @default(cuid())
  editionId           String
  edition             CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  teamId              String
  editionTeam         EditionTeam        @relation(fields: [editionId, teamId], references: [editionId, teamId], onDelete: Restrict)
  editionDisciplineId String
  editionDiscipline   EditionDiscipline  @relation(fields: [editionId, editionDisciplineId], references: [editionId, id], onDelete: Restrict)
  metricId            String
  metric              OverallMetric      @relation(fields: [editionId, metricId], references: [editionId, clientId], onDelete: Restrict)
  points              Int
  note                String?
  origin              OverallAwardOrigin @default(MANUAL)

  revokedAt     DateTime? @db.Timestamptz(3)
  revokedById   String?
  revokedBy     Staff?    @relation("OverallAwardRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedByName String?
  revokeReason  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([editionId, createdAt])
  @@index([editionId, teamId, revokedAt])
  @@index([editionId, editionDisciplineId])
  @@index([editionId, metricId])
  @@index([revokedById])
  @@map("overall_awards")
}

model OverallClosure {
  id        String             @id @default(cuid())
  editionId String
  edition   CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     Staff?             @relation("OverallClosureActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  note      String?
  closedAt  DateTime           @db.Timestamptz(3)

  reopenedAt   DateTime? @db.Timestamptz(3)
  reopenedById String?
  reopenedBy   Staff?    @relation("OverallClosureReopenedBy", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([editionId, reopenedAt])
  @@index([actorId])
  @@index([reopenedById])
  @@map("overall_closures")
}

model RefreshSession {
  id        String              @id @default(cuid())
  tokenHash String              @unique
  staffId   String
  staff     Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  editionId String?
  edition   CompetitionEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  rotatedFromId String?         @unique
  rotatedFrom   RefreshSession? @relation("RefreshSessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     RefreshSession? @relation("RefreshSessionRotation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, revokedAt, expiresAt])
  @@index([editionId])
  @@map("refresh_sessions")
}

model EditionActionReceipt {
  id             String             @id @default(cuid())
  editionId      String
  edition        CompetitionEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  idempotencyKey String
  actionType     String
  requestHash    String
  resultRevision Int
  responseData   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([editionId, idempotencyKey])
  @@index([editionId, createdAt])
  @@index([idempotencyKey, createdAt])
  @@map("edition_action_receipts")
}

model AuditLog {
  id        String              @id @default(cuid())
  editionId String?
  edition   CompetitionEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  staffId   String?
  staff     Staff?              @relation(fields: [staffId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  reason     String?

  createdAt DateTime @default(now())

  @@index([editionId, createdAt])
  @@index([editionId, action, createdAt])
  @@index([entityType, entityId])
  @@index([staffId])
  @@map("audit_logs")
}
