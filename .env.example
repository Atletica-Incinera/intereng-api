NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/competitions?schema=public
# A senha faz parte da URL: o Redis do docker-compose passou a exigir
# autenticação, então conectar sem ela falha. Se você usa um Redis próprio sem
# senha, remova o trecho `:senha@`.
REDIS_URL=redis://:intereng_redis_local@localhost:6379
# Alimenta o `--requirepass` do container e precisa bater com a REDIS_URL acima.
REDIS_PASSWORD=intereng_redis_local

JWT_SECRET=local-access-secret-change-in-production
JWT_REFRESH_SECRET=local-refresh-secret-change-in-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
STAFF_INVITE_PASSWORD=intereng2026

# Primeira conta de super administrador. Um banco recém-migrado não tem caminho
# para ela: o login exige uma linha em `staff`, criar staff exige uma sessão de
# super administrador, e o seed recusa NODE_ENV=production. A API cria a conta
# no boot APENAS quando não existe nenhum super administrador — depois disso as
# duas variáveis podem ficar aqui sem efeito. Elas andam juntas: definir só uma
# derruba o boot. A conta nasce exigindo troca de senha no primeiro acesso, então
# este valor é provisório.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
CORS_ORIGINS=http://app.localhost,http://localhost:3001
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Caminho do cookie de refresh. Vazio significa "/", que funciona sob qualquer
# montagem — inclusive quando um proxy serve a API sob outro prefixo. Só defina
# se quiser restringir o escopo ao caminho público real.
COOKIE_PATH=

PII_PEPPER=local-pii-pepper-change-in-production
PII_ENCRYPTION_KEY=local-32-byte-key-change-me-now!

# São TRÊS endereços diferentes, e confundi-los é o erro mais fácil aqui:
#   S3_ENDPOINT        — quem usa é a API, pela rede interna do Docker.
#   S3_PRESIGN_ENDPOINT — quem usa é o NAVEGADOR, para enviar o arquivo.
#   S3_PUBLIC_BASE_URL  — quem usa é o NAVEGADOR, para exibir a logo depois.
# Os dois últimos precisam ser alcançáveis de fora da VM, ou seja, passar pelo
# proxy. No Compose o S3_ENDPOINT já vem definido apontando para o container.
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intereng
S3_ACCESS_KEY_ID=intereng
# Obrigatória: alimenta o MINIO_ROOT_PASSWORD do container e a credencial da
# API a partir da mesma variável, para não existir estado em que uma mude sem a
# outra. A stack recusa subir sem ela.
S3_SECRET_ACCESS_KEY=intereng-local-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/intereng
S3_PRESIGN_TTL_SECONDS=300
S3_MAX_LOGO_BYTES=8388608

REDIS_STREAM_TTL=3600
LOG_LEVEL=debug

SEED_DEMO_DATA=false
SEED_BCRYPT_ROUNDS=10
